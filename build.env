: "${OPENWRT_REPOSITORY:=perceival/openwrt-flint3}"
: "${OPENWRT_BRANCH:=flint3-be9300}"
: "${OPENWRT_COMMIT:=d90c181d96257c58ac370c19bbd640be7d9c0d76}"

# Perceival's mac80211 package targets Linux 7.2-rc4, but the referenced
# pre-generated archive is not published. Generate it from these pinned
# upstream inputs and place it in OpenWrt's normal download cache.
: "${BACKPORTS_REPOSITORY:=openwrt/backports}"
: "${BACKPORTS_COMMIT:=614e5ed4d40d33cbb99313842a4b4bde264a4b2b}"
: "${BACKPORTS_LINUX_REPOSITORY:=https://github.com/torvalds/linux.git}"
: "${BACKPORTS_LINUX_COMMIT:=1590cf0329716306e948a8fc29f1d3ee87d3989f}"
: "${BACKPORTS_KERNEL_VERSION:=7.2-rc4}"
: "${BACKPORTS_ARCHIVE:=backports-7.2-rc4.tar.zst}"

: "${PACKAGES_FEED_REPOSITORY:=openwrt/packages}"
: "${PACKAGES_FEED_COMMIT:=aad6a5a68c592969eff2352154f157c6e0382436}"
: "${LUCI_FEED_REPOSITORY:=openwrt/luci}"
: "${LUCI_FEED_COMMIT:=fe9d6b4f09f3bc30a3f62abf00ac5542a3a98f90}"

: "${FOOTSTRAP_REPOSITORY:=VizzleTF/luci-theme-footstrap}"
: "${FOOTSTRAP_COMMIT:=e2da4874aa873497b5af91eea5f5f1c89a7caed2}"
: "${FOOTSTRAP_VERSION:=0.0.0_git20260731}"
