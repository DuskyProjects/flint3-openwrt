#!/bin/sh

# Register Footstrap and make it the active LuCI theme. Bootstrap remains
# installed as a fallback and can still be selected manually later.
uci -q set luci.themes.Footstrap='/luci-static/footstrap'
uci -q set luci.main.mediaurlbase='/luci-static/footstrap'
uci -q commit luci

rm -f /tmp/luci-indexcache* 2>/dev/null || true
rm -rf /tmp/luci-modulecache 2>/dev/null || true

exit 0
