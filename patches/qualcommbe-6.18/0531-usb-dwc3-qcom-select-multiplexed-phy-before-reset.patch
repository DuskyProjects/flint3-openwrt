From: DuskyProjects <actions@users.noreply.github.com>
Subject: [PATCH] usb: dwc3: qcom: select multiplexed PHY before reset

IPQ5332 shares its SuperSpeed PHY pads with PCIe. Select the USB side of
the mux before the DWC3 wrapper reset so operation does not depend on the
bootloader's inherited register state.

The property names, register phandle format, and value follow Qualcomm's
downstream IPQ5332 implementation. Boards without
qcom,multiplexed-phy are unchanged.

---
 drivers/usb/dwc3/dwc3-qcom-legacy.c | 37 +++++++++++++++++++++++++++++
 1 file changed, 37 insertions(+)

--- a/drivers/usb/dwc3/dwc3-qcom-legacy.c
+++ b/drivers/usb/dwc3/dwc3-qcom-legacy.c
@@ -13,6 +13,8 @@
 #include <linux/module.h>
 #include <linux/kernel.h>
 #include <linux/extcon.h>
+#include <linux/mfd/syscon.h>
+#include <linux/regmap.h>
 #include <linux/interconnect.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
@@ -698,6 +700,36 @@ static int dwc3_qcom_of_register_core(struct platform_device *pdev)
 	return ret;
 }
 
+static int dwc3_qcom_select_phy_mux(struct dwc3_qcom *qcom)
+{
+	struct of_phandle_args args;
+	struct regmap *map;
+	int ret;
+
+	if (!device_property_read_bool(qcom->dev, "qcom,multiplexed-phy"))
+		return 0;
+
+	ret = of_parse_phandle_with_fixed_args(qcom->dev->of_node,
+					       "qcom,phy-mux-regs", 1, 0,
+					       &args);
+	if (ret)
+		return dev_err_probe(qcom->dev, ret,
+				     "failed to parse qcom,phy-mux-regs\n");
+
+	map = syscon_node_to_regmap(args.np);
+	of_node_put(args.np);
+	if (IS_ERR(map))
+		return dev_err_probe(qcom->dev, PTR_ERR(map),
+				     "failed to map USB PHY mux register\n");
+
+	ret = regmap_write(map, args.args[0], 0x1);
+	if (ret)
+		return dev_err_probe(qcom->dev, ret,
+				     "failed to select USB PHY mux\n");
+
+	return 0;
+}
+
 static int dwc3_qcom_probe(struct platform_device *pdev)
 {
 	struct device_node	*np = pdev->dev.of_node;
@@ -716,6 +748,11 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 	platform_set_drvdata(pdev, qcom);
 	qcom->dev = &pdev->dev;
 
+	/* The mux must select USB before the wrapper reset is asserted. */
+	ret = dwc3_qcom_select_phy_mux(qcom);
+	if (ret)
+		return ret;
+
 	qcom->resets = devm_reset_control_array_get_optional_exclusive(dev);
 	if (IS_ERR(qcom->resets)) {
 		return dev_err_probe(&pdev->dev, PTR_ERR(qcom->resets),
