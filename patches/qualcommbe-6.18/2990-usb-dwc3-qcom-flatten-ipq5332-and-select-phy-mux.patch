From: DuskyProjects <actions@users.noreply.github.com>
Subject: [PATCH] usb: dwc3: qcom: flatten IPQ5332 and select PHY mux early

Migrate IPQ5332 from the legacy nested qcom,dwc3 wrapper to the flat
qcom,snps-dwc3 binding used by the current Qualcomm glue driver.

IPQ5332 shares the SuperSpeed pads with PCIe. Qualcomm-derived sources
select USB through TCSR register 0x01947540 before the USB controller
reset. Do the same in dwc3-qcom so boot does not depend on inherited
bootloader state. Only boards carrying qcom,multiplexed-phy request the
mux write, matching the downstream board opt-in behavior.

This patch is intentionally ordered after the existing Qualcomm DTS
series, including the IPQ5332 QPIC additions, so those patches can still
match the legacy USB node used as their trailing context.

---
--- a/drivers/usb/dwc3/dwc3-qcom.c
+++ b/drivers/usb/dwc3/dwc3-qcom.c
@@ -8,6 +8,8 @@
 #include <linux/of_clk.h>
 #include <linux/module.h>
 #include <linux/kernel.h>
+#include <linux/mfd/syscon.h>
+#include <linux/regmap.h>
 #include <linux/interconnect.h>
 #include <linux/platform_device.h>
 #include <linux/phy/phy.h>
@@ -603,6 +605,34 @@ struct dwc3_glue_ops dwc3_qcom_glue_ops = {
 	.pre_run_stop	= dwc3_qcom_run_stop_notifier,
 };
 
+static int dwc3_qcom_select_ipq5332_phy_mux(struct device *dev)
+{
+	struct regmap *tcsr;
+	int ret;
+
+	if (!of_property_read_bool(dev->of_node, "qcom,multiplexed-phy"))
+		return 0;
+
+	if (!of_device_is_compatible(dev->of_node, "qcom,ipq5332-dwc3"))
+		return dev_err_probe(dev, -EINVAL,
+				     "multiplexed PHY is unsupported on this controller\n");
+
+	tcsr = syscon_regmap_lookup_by_compatible("qcom,tcsr-ipq5332");
+	if (IS_ERR(tcsr))
+		return dev_err_probe(dev, PTR_ERR(tcsr),
+				     "failed to map IPQ5332 TCSR\n");
+
+	/*
+	 * TCSR base 0x01937000 + 0x10540 = 0x01947540.
+	 * Bit 0 selects the USB side of the USB/PCIe PHY mux.
+	 */
+	ret = regmap_write(tcsr, 0x10540, 0x1);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to select IPQ5332 USB PHY mux\n");
+
+	return 0;
+}
+
 static int dwc3_qcom_probe(struct platform_device *pdev)
 {
 	struct dwc3_probe_data	probe_data = {};
@@ -624,6 +654,10 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 
 	qcom->dev = &pdev->dev;
 
+	ret = dwc3_qcom_select_ipq5332_phy_mux(dev);
+	if (ret)
+		return ret;
+
 	qcom->resets = devm_reset_control_array_get_optional_exclusive(dev);
 	if (IS_ERR(qcom->resets)) {
 		return dev_err_probe(&pdev->dev, PTR_ERR(qcom->resets),
--- a/arch/arm64/boot/dts/qcom/ipq5332.dtsi
+++ b/arch/arm64/boot/dts/qcom/ipq5332.dtsi
@@ -425,11 +425,13 @@
-		usb: usb@8af8800 {
-			compatible = "qcom,ipq5332-dwc3", "qcom,dwc3";
-			reg = <0x08af8800 0x400>;
+		usb: usb_dwc: usb@8a00000 {
+			compatible = "qcom,ipq5332-dwc3", "qcom,snps-dwc3";
+			reg = <0x08a00000 0x100000>;
 
-			interrupts = <GIC_SPI 62 IRQ_TYPE_LEVEL_HIGH>,
+			interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 62 IRQ_TYPE_LEVEL_HIGH>,
 				     <GIC_SPI 53 IRQ_TYPE_LEVEL_HIGH>,
 				     <GIC_SPI 52 IRQ_TYPE_LEVEL_HIGH>;
-			interrupt-names = "pwr_event",
+			interrupt-names = "dwc_usb3",
+					  "pwr_event",
 					  "dp_hs_phy_irq",
 					  "dm_hs_phy_irq";
 
@@ -451,27 +453,17 @@
 
 			qcom,select-utmi-as-pipe-clk;
 
-			#address-cells = <1>;
-			#size-cells = <1>;
-			ranges;
 			interconnects = <&gcc MASTER_SNOC_USB &gcc SLAVE_SNOC_USB>,
 					<&gcc MASTER_SNOC_USB &gcc SLAVE_SNOC_USB>;
 			interconnect-names = "usb-ddr", "apps-usb";
 
-			status = "disabled";
-
-			usb_dwc: usb@8a00000 {
-				compatible = "snps,dwc3";
-				reg = <0x08a00000 0xe000>;
-				clocks = <&gcc GCC_USB0_MOCK_UTMI_CLK>;
-				clock-names = "ref";
-				interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;
-				phy-names = "usb2-phy";
-				phys = <&usbphy0>;
-				tx-fifo-resize;
-				snps,is-utmi-l1-suspend;
-				snps,hird-threshold = /bits/ 8 <0x0>;
-				snps,dis_u2_susphy_quirk;
-				snps,dis_u3_susphy_quirk;
-			};
+			phy-names = "usb2-phy";
+			phys = <&usbphy0>;
+			tx-fifo-resize;
+			snps,is-utmi-l1-suspend;
+			snps,hird-threshold = /bits/ 8 <0x0>;
+			snps,dis_u2_susphy_quirk;
+			snps,dis_u3_susphy_quirk;
+
+			status = "disabled";
 		};
